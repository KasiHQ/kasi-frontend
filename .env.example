# Kasi Frontend Environment Configuration Template

# Live Demo & Support WhatsApp contact numbers (E.164 format without '+' e.g. 2348000000000)
VITE_DEMO_WHATSAPP=2348000000000
VITE_SUPPORT_WHATSAPP=2348000000000

# Backend API endpoint
VITE_API_URL=https://api.usekasi.com

# Direct App Sign-in & Authentication URL
VITE_APP_SIGNIN_URL=/login

# Prelaunch Waitlist Mode Flag ('true' or 'false')
VITE_PRELAUNCH_WAITLIST_MODE=false
